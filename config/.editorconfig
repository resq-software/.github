# Canonical ResQ .editorconfig — copy to a repo root.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs}]
indent_size = 4

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false  # two trailing spaces = hard line break

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2
